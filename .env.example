# Copy this file to .env.local and fill in the values from your Supabase project.
# These are browser-safe values. Never add the service-role key to a Vite variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set these as Supabase Edge Function secrets, never in this file or Vercel.
# ADMIN_PASSWORD=
# ADMIN_ALLOWED_ORIGIN=https://your-domain.vercel.app
